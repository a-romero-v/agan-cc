{
    "type": "project",
    "license": "proprietary",
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require": {
        "php": ">=8.5",
        "ext-ctype": "*",
        "ext-iconv": "*",
        "doctrine/doctrine-bundle": "^3.4",
        "doctrine/doctrine-migrations-bundle": "^4.0",
        "doctrine/orm": "^3.7",
        "symfony/console": "8.1.*",
        "symfony/doctrine-messenger": "8.1.*",
        "symfony/dotenv": "8.1.*",
        "symfony/flex": "^2",
        "symfony/framework-bundle": "8.1.*",
        "symfony/messenger": "8.1.*",
        "symfony/monolog-bundle": "^4.1",
        "symfony/runtime": "8.1.*",
        "symfony/yaml": "8.1.*"
    },
    "require-dev": {
        "deptrac/deptrac": "*",
        "friendsofphp/php-cs-fixer": "*",
        "phpstan/extension-installer": "*",
        "phpstan/phpstan": "*",
        "phpstan/phpstan-doctrine": "^2.1",
        "phpstan/phpstan-symfony": "*",
        "phpunit/phpunit": "*"
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": true,
            "symfony/flex": true,
            "symfony/runtime": true,
            "phpstan/extension-installer": true
        },
        "bump-after-update": true,
        "sort-packages": true
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "replace": {
        "symfony/polyfill-ctype": "*",
        "symfony/polyfill-iconv": "*",
        "symfony/polyfill-php72": "*",
        "symfony/polyfill-php73": "*",
        "symfony/polyfill-php74": "*",
        "symfony/polyfill-php80": "*",
        "symfony/polyfill-php81": "*",
        "symfony/polyfill-php82": "*",
        "symfony/polyfill-php83": "*",
        "symfony/polyfill-php84": "*"
    },
    "scripts": {
        "auto-scripts": {
            "cache:clear": "symfony-cmd",
            "assets:install %PUBLIC_DIR%": "symfony-cmd"
        },
        "post-install-cmd": [
            "@auto-scripts"
        ],
        "post-update-cmd": [
            "@auto-scripts"
        ],
        "app:cs:check": "vendor/bin/php-cs-fixer fix --dry-run --diff",
        "app:cs:fix": "vendor/bin/php-cs-fixer fix",
        "app:analyse": [
            "@php bin/console cache:warmup --env=dev --quiet",
            "php -d memory_limit=512M vendor/bin/phpstan analyse --no-progress"
        ],
        "app:deptrac": [
            "vendor/bin/deptrac analyse --config-file=deptrac.yaml --no-progress",
            "vendor/bin/deptrac analyse --config-file=deptrac-contexts.php --no-progress"
        ],
        "app:test": "php bin/phpunit",
        "app:test:unit": "php bin/phpunit --testsuite unit",
        "app:test:integration": "php bin/phpunit --testsuite integration",
        "app:test:clear:cache": "@php bin/console cache:clear --env=test",
        "app:openapi:build": "@php bin/console app:openapi:build",
        "app:openapi:check-sync": "@php bin/console app:openapi:check-sync",
        "app:validate:openapi": "@php bin/validate-openapi docs/openapi.yaml",
        "app:qa": [
            "@app:openapi:check-sync",
            "@app:validate:openapi",
            "@composer audit",
            "@app:cs:check",
            "@app:analyse",
            "@app:deptrac",
            "@app:test"
        ],
        "app:db:reset": "@php bin/console app:db:reset --env=dev",
        "app:db:reset:test": "@php bin/console app:db:reset --env=test"
    },
    "conflict": {
        "symfony/symfony": "*"
    },
    "extra": {
        "symfony": {
            "allow-contrib": false,
            "require": "8.1.*",
            "docker": false
        }
    }
}
